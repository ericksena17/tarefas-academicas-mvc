<%- include('../partials/inicio') %>
<a class="voltar" href="/tarefas">← Voltar para minhas tarefas</a>
<div class="cabecalho-pagina"><div><p class="sobretitulo">TAREFA #<%= String(tarefa.id).padStart(3, '0') %></p><h1>Detalhes da tarefa</h1><p class="subtitulo">Todas as informações da sua atividade.</p></div><a class="botao secundario" href="/tarefas/<%= tarefa.id %>/editar">Editar tarefa</a></div>
<article class="painel detalhes-painel"><span class="status <%= tarefa.status %>"><%= tarefa.status === 'pendente' ? 'Pendente' : 'Concluída' %></span><h2 class="detalhes-titulo"><%= tarefa.titulo %></h2><dl><dt>Identificador</dt><dd><%= tarefa.id %></dd><dt>Disciplina</dt><dd><%= tarefa.disciplina %></dd><dt>Descrição</dt><dd class="descricao"><%= tarefa.descricao || 'Nenhuma descrição informada.' %></dd></dl><div class="detalhes-acoes"><% if (tarefa.status === 'pendente') { %><form method="post" action="/tarefas/<%= tarefa.id %>/concluir"><button class="botao primario" type="submit">Concluir tarefa</button></form><% } else { %><p class="verde">Esta tarefa já foi concluída.</p><% } %><a class="botao perigo-suave" href="/tarefas/<%= tarefa.id %>/excluir">Excluir tarefa</a></div></article>
<%- include('../partials/fim') %>
